# Normalize line endings; keep scripts/JS on LF even on Windows checkouts.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Binary files
*.docx binary
*.png binary
*.node binary
*.so binary
*.jar binary
*.zip binary
